<?xml version="1.0" encoding="utf-8"?>
<!-- How long the list is, told in the same tint as the tiles under it. The
     sheet's own roles rather than the page's: this chip lives on the sheet, and
     the lens opens this list over whatever app is underneath. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/card_chip_accent_fill" />
    <corners android:radius="999dp" />
    <stroke
        android:width="1dp"
        android:color="@color/card_chip_accent_edge" />
</shape>
