<?xml version="1.0" encoding="utf-8"?>
<!-- A drawing of the screen Android is about to show — not a screenshot, so
     it can never be out of date or wrong for the phone in hand. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- The screen it draws is the one the person is about to meet, so the
         panel turns with the theme too: a step of cream under paper by day,
         the charcoal mock at night. -->
    <solid android:color="@color/ask_guide_screen" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="@color/ask_guide_screen_edge" />
</shape>
