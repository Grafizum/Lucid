<?xml version="1.0" encoding="utf-8"?>
<!-- The translation card core. It takes the theme's surface, so on the day theme
     it is paper with an ink hairline and at night it is the charcoal card that
     reads over any app underneath. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/card_surface" />
    <corners android:radius="19dp" />
    <stroke android:width="1dp" android:color="@color/card_edge" />
</shape>
