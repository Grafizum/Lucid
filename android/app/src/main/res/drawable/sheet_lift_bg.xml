<?xml version="1.0" encoding="utf-8"?>
<!-- The picker sheet, dressed as the study's deep lift.

     Paper all the way down, with its own hairline all the way round. The depth
     comes from the view's elevation and from the margin it floats clear of the
     page — not from a fill that lets the page read through its lower third,
     which put a ghost of the settings rows under the last languages of the
     list.

     There is no lit line inside the top edge. Drawn thin it read as a stray
     rule lying across the sheet rather than as light on its rim, and the sheet
     already says it is a surface by floating a margin clear of the page. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerY="0.58"
                android:centerColor="@color/sheet_lift_mid"
                android:endColor="@color/sheet_lift_floor"
                android:startColor="@color/sheet_lift_top" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/sheet_lift_edge" />
        </shape>
    </item>
</layer-list>
