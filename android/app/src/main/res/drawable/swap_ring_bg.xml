<?xml version="1.0" encoding="utf-8"?>
<!-- The ring the pair swaps through: paper with the card's stronger hairline, so
     it lifts off the card and off the seam it sits on. No size of its own — the
     card sets it, because the ring is drawn at the same 33 dp as the two discs
     beside it and a fixed size here would only ever be the wrong one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/screen_card" />
    <stroke android:width="1dp" android:color="@color/screen_edge_strong" />
</shape>
