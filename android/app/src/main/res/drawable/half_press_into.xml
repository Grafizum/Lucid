<?xml version="1.0" encoding="utf-8"?>
<!-- The same press on the Into half, mirrored: the card's corners on the right
     and bottom edges, square where it meets the seam. See half_press_from for
     why the ring is gone. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/screen_half_press" />
    <corners
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="16dp"
        android:topLeftRadius="0dp"
        android:topRightRadius="16dp" />
</shape>
