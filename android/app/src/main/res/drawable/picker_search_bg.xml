<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's one input: a well sunk a shade into the sheet, round as the
     chips, so the field reads as part of the same set of controls as the
     language that was picked before it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/card_chip_fill" />
    <corners android:radius="999dp" />
    <stroke
        android:width="1dp"
        android:color="@color/card_chip_edge" />
</shape>
