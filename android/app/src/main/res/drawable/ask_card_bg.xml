<?xml version="1.0" encoding="utf-8"?>
<!-- The surface under a question: paper by day, charcoal at night, with the
     page's corner and a hairline of its own. It used to be charcoal in both
     themes, which made setup, the consent and the permission guide three dark
     popups standing over a light page. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/ask_surface" />
    <corners android:radius="19dp" />
    <stroke
        android:width="1dp"
        android:color="@color/ask_card_edge" />
</shape>
