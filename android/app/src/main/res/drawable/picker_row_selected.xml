<?xml version="1.0" encoding="utf-8"?>
<!-- The row that is already in force: a wash of the accent and its hairline,
     under the same corner as the sheet's other cards. The tick at its end says
     the same thing again in a mark, so the choice is not carried by colour
     alone. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/card_chip_accent_fill" />
    <corners android:radius="13dp" />
    <stroke
        android:width="1dp"
        android:color="@color/card_chip_accent_edge" />
</shape>
