<?xml version="1.0" encoding="utf-8"?>
<!-- The lens glyph: a ring with a clay eye, drawn on the lens disc. The ring and
     the ticks are the theme's ink, so they turn dark on the day lens. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="26dp"
    android:height="26dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M12,5.9 a6.1,6.1 0 1,0 0.01,0 z"
        android:strokeWidth="1.45"
        android:strokeColor="@color/lens_glyph"
        android:fillColor="#00000000" />
    <path
        android:pathData="M12,10.35 a1.65,1.65 0 1,0 0.01,0 z"
        android:fillColor="@color/lens_glyph_soft" />
    <path
        android:pathData="M12,1.2 L12,4.7 M12,19.3 L12,22.8 M1.2,12 L4.7,12 M19.3,12 L22.8,12"
        android:strokeWidth="1.45"
        android:strokeColor="@color/lens_glyph"
        android:strokeLineCap="round" />
</vector>
