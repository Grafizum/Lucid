<?xml version="1.0" encoding="utf-8"?>
<!-- The tile in front of a language: its first letter, set on the accent tint.
     A flag would name a country, and most of the languages in this list do not
     have one that is honest, so the row carries a letter instead. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/card_chip_accent_fill" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="@color/card_chip_accent_edge" />
</shape>
