<?xml version="1.0" encoding="utf-8"?>
<!-- The lens: a machined disc, lit from the top-left. Its colours come from the
     theme, so on the day screen it is paper with an ink hairline and at night it
     is the charcoal disc it has always been. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:centerX="0.34"
        android:centerY="0.24"
        android:endColor="@color/lens_surface"
        android:gradientRadius="86dp"
        android:startColor="@color/lens_surface_high"
        android:type="radial" />
    <stroke android:width="1dp" android:color="@color/lens_ring" />
</shape>
