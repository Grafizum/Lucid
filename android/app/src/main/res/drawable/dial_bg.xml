<?xml version="1.0" encoding="utf-8"?>
<!-- The swap control's own disc: paper with a hairline, so it separates from a
     beige pill on either side instead of joining one of them. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <solid android:color="@color/screen_card" />
    <stroke android:width="1dp" android:color="@color/screen_edge" />
    <size android:width="26dp" android:height="26dp" />
</shape>
