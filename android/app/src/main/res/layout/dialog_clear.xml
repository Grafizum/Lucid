<?xml version="1.0" encoding="utf-8"?>
<!-- Clearing the reads, asked before it happens: a card of the page's own paper,
     the count that goes, and two answers — the quiet one first. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_sheet_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lucid_sans"
        android:letterSpacing="-0.015"
        android:text="Clear the reads?"
        android:textColor="@color/screen_ink"
        android:textFontWeight="600"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/clearBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/lucid_sans"
        android:lineSpacingMultiplier="1.5"
        android:text="The reads kept on this phone go — the lines, the answers, where and when. Nothing was uploaded, so there is no other copy and this cannot be undone."
        android:textColor="@color/screen_muted"
        android:textSize="12.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/clearKeep"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:text="Keep them"
            android:textColor="@color/screen_ink"
            android:textFontWeight="500"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/clearConfirm"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:text="Clear all"
            android:textColor="@color/btn_primary_ink"
            android:textFontWeight="600"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
