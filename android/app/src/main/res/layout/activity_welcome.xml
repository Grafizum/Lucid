<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="18dp"
    android:paddingEnd="26dp"
    android:paddingBottom="16dp">

    <!-- The language the lens reads into, in the corner the main screen keeps
         its chip in, named in its own language: someone who picked Japanese is
         looking for "日本語", not the English word for it. No caption — the
         corner carries the language alone, as home does. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/welcomeLang"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/btn_ghost"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="English"
            android:textColor="@color/screen_ink"
            android:textSize="10.5sp" />

    </LinearLayout>

    <!-- One hero, centred: the mark in its breathing circle, the hint right
         under it, then the welcome itself. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <com.grafizum.lucid.WelcomeMark
            android:id="@+id/welcomeMark"
            android:layout_width="match_parent"
            android:layout_height="252dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:text="Tap the lens to begin"
            android:textColor="@color/screen_muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:letterSpacing="-0.025"
            android:text="Welcome to Lucid"
            android:textColor="@color/screen_ink"
            android:textFontWeight="500"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:lineSpacingMultiplier="1.45"
            android:text="Point it at anything on your screen and it reads it where it stands."
            android:textColor="@color/screen_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lucid_sans"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:text="Shipped with Grafizum.com"
        android:textColor="@color/screen_faint"
        android:textSize="9.5sp" />
</LinearLayout>
