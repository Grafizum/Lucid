<?xml version="1.0" encoding="utf-8"?>
<!-- The one-time setup sheet, asked as the app opens. Charcoal, so it reads as
     a different voice from the parchment page behind it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_dark_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lucid_sans"
        android:letterSpacing="0.2"
        android:text="One-time setup"
        android:textAllCaps="true"
        android:textColor="@color/clay_300"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/setupTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="@font/lucid_sans"
        android:letterSpacing="-0.02"
        android:text="Allow, swipe, read"
        android:textColor="@color/cream_50"
        android:textFontWeight="500"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/setupBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="@font/lucid_sans"
        android:lineSpacingMultiplier="1.45"
        android:text="Two permissions, one swipe, and the lens is on. Nothing is recorded and no frame is saved."
        android:textColor="@color/sand_400"
        android:textSize="11.5sp" />

    <!-- The whole of onboarding, in three lines: what to allow, how to start,
         and what to do once it is on. Anything more is a manual. -->
    <TextView
        android:id="@+id/setupSteps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/lucid_sans"
        android:lineSpacingMultiplier="1.55"
        android:text="1  Allow both switches\n2  Swipe “Start the lens” to the right\n3  Drag the lens onto any text — that’s it"
        android:textColor="@color/sand_300"
        android:textSize="11.5sp" />

    <!-- Text access is asked in the open: what the lens reads, where that text
         goes, and a tap that says yes — kept separate from the switches. The
         words live in one block, because settings asks the same question. -->
    <include
        layout="@layout/consent_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

    <!-- row: float over other apps -->
    <LinearLayout
        android:id="@+id/setupRow1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lucid_sans"
                android:text="Float over other apps"
                android:textColor="@color/cream_50"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/lucid_sans"
                android:text="Lets the lens sit on top of any app"
                android:textColor="@color/sand_500"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/setupBtn1"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_dark_solid"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:minWidth="76dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Allow"
            android:textColor="@color/ink_900"
            android:textFontWeight="500"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- row: text access -->
    <LinearLayout
        android:id="@+id/setupRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lucid_sans"
                android:text="Text access"
                android:textColor="@color/cream_50"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/lucid_sans"
                android:text="Reads the text under the lens"
                android:textColor="@color/sand_500"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/setupBtn2"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_dark_solid"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:minWidth="76dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Allow"
            android:textColor="@color/ink_900"
            android:textFontWeight="500"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/setupLater"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_dark_outline"
        android:fontFamily="@font/lucid_sans"
        android:gravity="center"
        android:minWidth="96dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="Later"
        android:textColor="@color/sand_300"
        android:textFontWeight="500"
        android:textSize="11.5sp" />
</LinearLayout>
