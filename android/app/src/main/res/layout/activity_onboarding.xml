<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/obRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="18dp"
    android:paddingEnd="26dp"
    android:paddingBottom="18dp">

    <!-- The app's language, in the corner, in that language's own name:
         "日本語", not "Japanese". It is the one switch for the language: the
         page it opens is the page Settings opens, and the pick is put in force
         on every screen at once. No caption — the corner carries the language
         alone. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <!-- The chip and the one line that explains it: a language being
             fetched, or the reason it cannot be. Nothing is said while the
             words are already on the phone. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/obLang"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/btn_ghost"
                android:fontFamily="@font/lucid_sans"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="English"
                android:textColor="@color/screen_ink"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/obLangState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/lucid_sans"
                android:lineSpacingMultiplier="1.2"
                android:maxWidth="230dp"
                android:textColor="@color/screen_faint"
                android:textSize="9.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- The theme, as one picture of the surface you are not on: a sun while
             the page is charcoal, a moon while it is paper. The button is drawn
             by the screen, because only it knows which way round it is; tapping
             it turns the page under the finger. The third answer — follow the
             phone — belongs in Settings, with the rest of the switchboard. -->
        <ImageView
            android:id="@+id/obTheme"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/btn_ghost"
            android:clickable="true"
            android:contentDescription="Switch the theme"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_moon" />

        <!-- Out of the tour at any page: a small word in the corner, not a
             button competing with the one at the foot. -->
        <TextView
            android:id="@+id/obSkip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/btn_ghost"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Skip"
            android:textColor="@color/screen_muted"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- The loop itself: a phone drawn flat on the page, with one gesture
         playing over and over until the page is left. -->
    <com.grafizum.lucid.OnboardingScene
        android:id="@+id/obScene"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/obTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/lucid_sans"
        android:letterSpacing="-0.02"
        android:textColor="@color/screen_ink"
        android:textFontWeight="500"
        android:textSize="23sp" />

    <TextView
        android:id="@+id/obBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="@font/lucid_sans"
        android:lineSpacingMultiplier="1.42"
        android:textColor="@color/screen_muted"
        android:textSize="12.5sp" />

    <LinearLayout
        android:id="@+id/obDots"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/obBack"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:text="Back"
            android:textColor="@color/screen_ink"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/obNext"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1.35"
            android:fontFamily="@font/lucid_sans"
            android:gravity="center"
            android:text="Next"
            android:textColor="@color/btn_primary_ink"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
