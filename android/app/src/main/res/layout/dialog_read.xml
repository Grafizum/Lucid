<?xml version="1.0" encoding="utf-8"?>
<!-- One read, opened: the answer at reading size, and under it the line it came
     from, which way it went, where it was read and when. The same card, type and
     hairlines the rest of the page uses, so opening a row feels like the row
     unfolding rather than another app taking over. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="15dp"
        android:paddingEnd="14dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detailLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/lucid_sans"
                android:includeFontPadding="false"
                android:letterSpacing="0.22"
                android:text="TRANSLATED"
                android:textColor="@color/screen_faint"
                android:textSize="9sp" />

            <!-- The card's own ✕, at the size the lens card draws it. -->
            <TextView
                android:id="@+id/detailClose"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:clickable="true"
                android:contentDescription="Close"
                android:focusable="true"
                android:fontFamily="@font/lucid_sans"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/screen_faint"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detailLangs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/detailTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fontFamily="@font/lucid_sans"
            android:lineSpacingMultiplier="1.34"
            android:textColor="@color/screen_ink"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="17dp"
            android:background="@color/screen_divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fontFamily="@font/lucid_sans"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:text="WHAT THE LENS READ"
            android:textColor="@color/screen_faint"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/detailSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/lucid_sans"
            android:lineSpacingMultiplier="1.42"
            android:textColor="@color/screen_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/detailMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/lucid_sans"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:textColor="@color/screen_faint"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>
