<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/app_bg"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="30dp"
    android:paddingEnd="32dp"
    android:paddingBottom="24dp">

    <!-- The top bar: the mark, the wordmark and the way into Settings. The mark
         is the launcher's own tile, not a redraw of it, so the wordmark is read
         beside the thing the app is on the home screen. It follows the theme:
         the paper plate in the day theme, the charcoal one (drawable-night) when
         the page is dark, so it stays a small icon rather than a light left on.
         The language is not repeated here: one switch owns it, in the tour's
         corner and in Settings, and a second copy on this page was two places to
         change one setting — and a way for them to disagree. -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mark_lens" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/lucid_sans"
            android:letterSpacing="-0.035"
            android:text="Lucid"
            android:textColor="@color/screen_ink"
            android:textFontWeight="500"
            android:textSize="25sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- settings, in the corner: one page for the switches Android asks
             for, the language and the theme, the apps that bring the lens up on
             their own, and what has been read. The theme lives in there and in
             the tour, and nowhere else — the home page does not carry a second
             door to it. -->
        <ImageView
            android:id="@+id/settingsBtn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_ghost"
            android:clickable="true"
            android:contentDescription="Settings"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_gear" />
    </LinearLayout>

    <!-- Only these scroll: the one-line intro, the lens's own switches, and the
         two pages below them. The switches change behaviour in place; the pages
         leave the screen, so they are two cards instead of one card split by
         hairlines. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sheetScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:importantForAutofill="no"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/lucid_sans"
                android:lineSpacingMultiplier="1.4"
                android:text="Reads whatever the lens sits over — WhatsApp, a browser, any app — and translates it in place."
                android:textColor="@color/screen_muted"
                android:textSize="13sp" />

            <!-- ── the lens ─────────────────────────────────────────────── -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/lucid_sans"
                android:letterSpacing="0.13"
                android:text="THE LENS"
                android:textColor="@color/screen_faint"
                android:textSize="8.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingTop="1dp"
                android:paddingEnd="13dp"
                android:paddingBottom="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="11dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_row_auto" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lucid_sans"
                            android:text="Auto-translate"
                            android:textColor="@color/screen_ink"
                            android:textFontWeight="500"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/autoHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/lucid_sans"
                            android:text="Reads when the lens stops"
                            android:textColor="@color/screen_faint"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/autoBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/chip_accent_bg"
                        android:fontFamily="@font/lucid_sans"
                        android:gravity="center"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="On"
                        android:textColor="@color/screen_accent_ink"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/screen_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="11dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_row_engine" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lucid_sans"
                            android:text="Engine"
                            android:textColor="@color/screen_ink"
                            android:textFontWeight="500"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/engHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/lucid_sans"
                            android:text="Best quality — sent online to translate"
                            android:textColor="@color/screen_faint"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/engBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/chip_accent_bg"
                        android:fontFamily="@font/lucid_sans"
                        android:gravity="center"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="Online"
                        android:textColor="@color/screen_accent_ink"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/screen_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="11dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_row_offline" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lucid_sans"
                            android:text="Offline only"
                            android:textColor="@color/screen_ink"
                            android:textFontWeight="500"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/offlineHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/lucid_sans"
                            android:text="No read ever leaves the phone"
                            android:textColor="@color/screen_faint"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/offlineBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/btn_ghost"
                        android:fontFamily="@font/lucid_sans"
                        android:gravity="center"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:text="Off"
                        android:textColor="@color/screen_ink"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- ── the pages ────────────────────────────────────────────── -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/lucid_sans"
                android:letterSpacing="0.13"
                android:text="PAGES"
                android:textColor="@color/screen_faint"
                android:textSize="8.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingTop="1dp"
                android:paddingEnd="10dp"
                android:paddingBottom="1dp">

                <LinearLayout
                    android:id="@+id/modelsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="11dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_row_pack" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lucid_sans"
                            android:text="Offline models"
                            android:textColor="@color/screen_ink"
                            android:textFontWeight="500"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/modelsHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/lucid_sans"
                            android:text="Downloaded language packs"
                            android:textColor="@color/screen_faint"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/screen_divider" />

                <LinearLayout
                    android:id="@+id/historyRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="11dp"
                    android:paddingBottom="11dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="11dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_row_history" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/lucid_sans"
                            android:text="Translation history"
                            android:textColor="@color/screen_ink"
                            android:textFontWeight="500"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/historyHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/lucid_sans"
                            android:text="What the lens has read, kept on this phone"
                            android:textColor="@color/screen_faint"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- the one CTA: a slide. Off, the well sits left and drags right; on, it
         sits right and drags left, with the cross beside it as the other way.
         A tap on the well runs the same slide — the drag stays the gesture, but
         a control that starts a product should not refuse a thumb. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/stopX"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/stopXBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:background="@drawable/stop_x_bg"
                android:clickable="true"
                android:contentDescription="Turn the lens off"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_close" />
            </FrameLayout>
        </FrameLayout>

        <com.grafizum.lucid.SwipeToStart
            android:id="@+id/startBtn"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- footer: one quiet line. Which build this is lives in Settings now — a
         version string is a diagnostic, not a signature. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/lucid_sans"
        android:gravity="center"
        android:letterSpacing="0.04"
        android:text="Shipped with Grafizum.com"
        android:textColor="@color/screen_faint"
        android:textSize="10sp" />

</LinearLayout>
