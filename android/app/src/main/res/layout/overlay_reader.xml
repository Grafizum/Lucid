<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="34dp"
        android:paddingEnd="16dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:id="@+id/readerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_lens_bg"
            android:elevation="18dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/lucid_sans"
                    android:letterSpacing="0.22"
                    android:text="READING"
                    android:textColor="@color/card_muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/readerClose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:clickable="true"
                    android:contentDescription="Close the reading sheet"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/card_faint"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- The whole answer, at reading size. Scrolling is the fallback
                 for a paragraph that still runs longer than the screen. -->
            <TextView
                android:id="@+id/readerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/lucid_sans"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/card_ink"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/readerOriginalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/lucid_sans"
                android:letterSpacing="0.16"
                android:text="ORIGINAL"
                android:textColor="@color/card_faint"
                android:textSize="8.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/readerOriginal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/lucid_sans"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/card_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/readerSpeak"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/btn_lens_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/lucid_sans"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Speak"
                    android:textColor="@color/card_muted"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/readerCopy"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/btn_lens_ghost"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/lucid_sans"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Copy"
                    android:textColor="@color/card_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
