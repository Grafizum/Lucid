<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The small question mark beside a title. A paragraph that explains a
         section belongs there when it is asked for, not under every heading:
         the mark is the question, the sheet it opens is the answer. -->
    <style name="InfoMark">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginStart">7dp</item>
        <item name="android:background">@drawable/bg_info_mark</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/lucid_sans</item>
        <item name="android:gravity">center</item>
        <item name="android:text">?</item>
        <item name="android:textColor">@color/screen_muted</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- One option in the appearance card. A row, not a button: it spans the card
         and takes the chosen pill in place, so the three read as one decision.
         The card's own 4dp padding is what keeps the pill off the card's edge. -->
    <style name="ThemeChoice">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/theme_choice_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/lucid_sans</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:textColor">@color/theme_choice_text</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
