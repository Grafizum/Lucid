<?xml version="1.0" encoding="utf-8"?>
<!-- Parchment & Charcoal, rosy taupe middle. See design/palette.md for the roles and the measured
     contrast of every pair used here. -->
<resources>

    <!-- cream — paper, light surfaces -->
    <color name="cream_50">#FCF8F1</color>
    <color name="cream_100">#F8F2E7</color>
    <color name="cream_200">#F1E9DA</color>
    <color name="cream_300">#E7DCC7</color>

    <!-- beige — the raised warm middle -->
    <color name="beige_200">#E4D8CE</color>
    <color name="beige_300">#D3C2B5</color>
    <color name="beige_400">#C7B2A4</color>
    <color name="beige_500">#AA8F7F</color>

    <!-- stone — muted text on cream -->
    <color name="stone_400">#A69C8C</color>
    <color name="stone_500">#857B6C</color>
    <color name="stone_600">#6A6254</color>

    <!-- charcoal — ink and dark canvas -->
    <color name="ink_900">#191814</color>
    <color name="ink_800">#23221E</color>
    <color name="ink_700">#2E2C27</color>
    <color name="ink_600">#3A3831</color>

    <!-- sand — muted text on charcoal -->
    <color name="sand_300">#D8CFBC</color>
    <color name="sand_400">#C2B9A6</color>
    <color name="sand_500">#A9A08E</color>

    <!-- clay — the only accent -->
    <color name="clay_300">#D3A582</color>
    <color name="clay_400">#B9825F</color>
    <color name="clay_500">#A46E4B</color>
    <color name="clay_600">#8A5A3C</color>
    <color name="clay_700">#6E4630</color>

    <!-- semantics, light surfaces then on-dark readings -->
    <color name="olive_600">#55603F</color>
    <color name="amber_600">#8A6A2B</color>
    <color name="rose_600">#8C3B2F</color>
    <color name="amber_300">#E3C58F</color>
    <color name="rose_300">#DFA79A</color>

    <!-- hairlines and translucent fills -->
    <color name="hairline_light">#14191814</color>
    <color name="divider_warm">#66C7B2A4</color>
    <color name="hairline_dark">#1AFCF8F1</color>
    <color name="shell_light">#FFD3C2B5</color>
    <color name="shell_dark">#E62E2C27</color>
    <color name="wash">#8CB39D7C</color>
    <color name="scrim">#8C14120F</color>

    <!-- The logo's own colours, sampled from the launcher icon itself, so the
         mark drawn on the welcome page cannot drift from the one on the home
         screen: cream frame and A, charcoal glass with a lighter crown, and the
         warm tan of the 文. -->
    <color name="logo_frame">#F2ECE0</color>
    <color name="logo_glass">#2A2621</color>
    <color name="logo_glass_high">#484239</color>
    <color name="logo_tan">#CDB896</color>
    <color name="logo_rim">#B4A893</color>
    <!-- The launcher drawing's own stops, from design/icon/lens-mark.svg. -->
    <color name="logo_cream_hi">#FDF8EC</color>
    <color name="logo_cream_mid">#F2E6CE</color>
    <color name="logo_cream_lo">#DBC9A8</color>
    <color name="logo_handle_hi">#F7EEDB</color>
    <color name="logo_handle_lo">#DFCFB1</color>
    <color name="logo_glass_hi">#332E26</color>
    <color name="logo_glass_mid">#282420</color>
    <color name="logo_glass_lo">#211E19</color>
    <color name="logo_glyph_a">#F6EFE3</color>
    <color name="logo_glyph_b">#D2B88E</color>

    <!-- The strip behind the navigation buttons. A light page wants the bar to
         disappear into it, and that is only safe from Android 8.1 (API 27),
         where the icons can be darkened — values-v27 makes it transparent. On
         7.x the icons are always white, so the same attribute would leave three
         invisible buttons on the page; there the bar stays charcoal. -->
    <color name="nav_bar">#191814</color>

    <!-- the lens bubble -->
    <color name="bubble_core">#16150F</color>
    <color name="bubble_edge">#38FCF8F1</color>

    <!-- The app screen's own roles. Everything the main screen draws reads one of
         these instead of a palette step, so the whole screen can change its
         clothes in values-night without touching a single palette entry — the
         lens, its card and the sheets are dark whatever the theme is, and they
         must not move when the page under them does. -->
    <color name="screen_canvas">#F8F2E7</color>
    <color name="screen_band">#E4D8CE</color>
    <color name="screen_shell">#D3C2B5</color>
    <color name="screen_card">#FCF8F1</color>
    <color name="screen_knob_low">#F8F2E7</color>
    <color name="screen_knob_high">#FCF8F1</color>
    <color name="screen_chip">#E4D8CE</color>
    <color name="screen_button">#F1E9DA</color>
    <color name="screen_dot">#C7B2A4</color>
    <color name="screen_ok">#55603F</color>
    <!-- The word of a permission that is granted: olive on paper, a light olive
         at night, where the deep olive would sink into the charcoal. -->
    <color name="screen_ok_ink">#55603F</color>
    <color name="screen_edge">#14191814</color>
    <color name="screen_divider">#66C7B2A4</color>
    <color name="screen_ink">#191814</color>
    <color name="screen_muted">#6A6254</color>
    <color name="screen_faint">#857B6C</color>
    <color name="screen_accent">#8A5A3C</color>
    <!-- Accent text that sits on an accent fill, not on the page. The fill is clay
         over cream, so the ground behind the words is darker than paper and the
         usual accent only reaches 4.2:1 there — under the floor for 11sp. One
         step down the clay stair buys 5.9:1 and keeps the hue. -->
    <color name="screen_accent_ink">#6E4630</color>
    <color name="screen_accent_soft">#B9825F</color>
    <!-- A chip that says "on" has to look like a chip, not a wash: at 12% the
         fill was so close to the card that the state read only from the words.
         20% keeps the card's calm and makes the tint a surface of its own, and
         the darker accent ink still clears 6:1 on it. -->
    <color name="screen_accent_fill">#33A46E4B</color>
    <color name="screen_accent_edge">#59A46E4B</color>
    <color name="screen_shade">#191814</color>
    <color name="screen_well">#F8F2E7</color>
    <color name="screen_well_shade">#1A191814</color>
    <color name="screen_well_rim">#8CB39D7C</color>

    <!-- The lens's own chrome. On the day theme it is paper: a pale disc with an
         ink hairline, ink glyphs and a paper pill under the word, so the lens
         reads as part of the page instead of a hole cut out of the night. The
         night theme re-points these to the charcoal dressing it always had. -->
    <color name="lens_surface">#F2FCF8F1</color>
    <color name="lens_surface_high">#F7F1E7</color>
    <color name="lens_ring">#4D191814</color>
    <color name="lens_glyph">#191814</color>
    <color name="lens_glyph_soft">#A46E4B</color>
    <color name="lens_label">#F2FCF8F1</color>
    <color name="lens_label_edge">#26191814</color>

    <!-- The lip is its own surface: a step of beige, not paper, so the handle on
         the edge still reads on a white page instead of vanishing into it, and a
         mid-tone hairline that shows over light and dark content alike. -->
    <color name="lens_lip_surface">#FFE4D8CE</color>
    <color name="lens_lip_ring">#8C6A6254</color>

    <!-- The translation card travels with the same theme: on the day theme it is
         paper with ink in it, at night it is the charcoal card it has always been. -->
    <color name="card_surface">#FCF8F1</color>
    <color name="card_edge">#14191814</color>
    <color name="card_ink">#191814</color>
    <color name="card_muted">#6A6254</color>
    <color name="card_faint">#857B6C</color>
    <color name="card_accent">#8A5A3C</color>
    <!-- The same fix on the card: a chip's own tint is not paper, so its label
         reads the darker clay instead of the accent used on the card itself. -->
    <color name="card_accent_ink">#6E4630</color>
    <color name="card_warn">#8A6A2B</color>
    <color name="card_danger">#8C3B2F</color>
    <color name="card_chip_fill">#10191814</color>
    <color name="card_chip_edge">#1F191814</color>
    <color name="card_chip_accent_fill">#1FA46E4B</color>
    <color name="card_chip_accent_edge">#40A46E4B</color>

</resources>
